# Offsite frontend — read from the shell environment at build / serve time (not loaded from a file).

# API base URL written into src/environments/environment.ts by set-env.js (default http://localhost:5000/api).
API_URL=http://localhost:5000/api
# "production" sets environment.production = true.
NODE_ENV=development
# Port of the SSR server (src/server.ts, default 4000).
PORT=4000
