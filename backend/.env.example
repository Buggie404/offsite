# Offsite backend — copy to backend/.env (`npm run setup:env` at the repo root) and fill in.
# Never commit real values. Variables marked (required in production) stop the server
# from starting when NODE_ENV=production and they are missing.

# ─── Runtime ───────────────────────────────────────────────────
# "production" turns on secure cookies and the strict checks below; anything else is dev.
NODE_ENV=development
# HTTP port of the API / socket.io server (default 5000).
PORT=5000

# ─── Database ──────────────────────────────────────────────────
# MongoDB connection string (required).
MONGODB_URI=
# Only used by scripts/tmp-check-user-points.js when connecting without SRV:
# replica set name and comma-separated host:port seeds.
MONGODB_REPLICA_SET=
MONGODB_SEED_HOSTS=

# ─── Auth secrets (required in production) ─────────────────────
# Long random strings, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`.
# Dev falls back to insecure placeholder values and logs a warning.
# Signs / verifies access tokens (REST, socket.io, OAuth redirects).
JWT_SECRET=
# Signs / verifies refresh tokens.
JWT_REFRESH_SECRET=
# Signs the express-session cookie used during OAuth logins.
SESSION_SECRET=

# ─── Frontend origin(s) (required in production) ───────────────
# Comma-separated. Only these origins may call the API or open sockets (CORS);
# http://localhost:4200 is also allowed outside production. OAuth redirects go to the first one.
CLIENT_URL=http://localhost:4200

# ─── OAuth ─────────────────────────────────────────────────────
# Google OAuth app credentials and the callback URL registered with Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/callback/google
# Facebook OAuth app credentials and the callback URL registered with Facebook.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:5000/auth/callback/facebook

# ─── AI chat (Dify) ────────────────────────────────────────────
# Dify API base URL (default https://api.dify.ai/v1) and app API key.
DIFY_API_BASE_URL=https://api.dify.ai/v1
DIFY_API_KEY=
# Model / provider label stored in AI call logs (default "dify-workflow").
LLM_MODEL=
LLM_PROVIDER=
# Max AI chat calls per day across the site (default 1000).
LLM_DAILY_LIMIT=1000
# Hotline shown when the AI hands the customer over (default "1900 0000").
SUPPORT_HOTLINE=
# Shared secret the chatbot sends in the x-chat-secret header to POST /api/chat/handoff.
CHAT_HANDOFF_SECRET=

# ─── Business rules ────────────────────────────────────────────
# Time zone for admin dashboard day boundaries (default Asia/Ho_Chi_Minh).
BUSINESS_TIMEZONE=Asia/Ho_Chi_Minh
# Days purchase points stay pending before they can be spent (default: the refund window).
POINTS_HOLD_DAYS=
# Reports needed before a community post is hidden automatically (default 5).
POST_AUTO_HIDE_THRESHOLD=5
# Demo only: "minute" makes the Ritual Box charge job treat every hour as a minute.
SUB_TIME_UNIT=
