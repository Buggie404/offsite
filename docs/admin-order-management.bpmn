          <dc:Bounds x="631" y="125" width="78" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_UpdateShipping_di" bpmnElement="Task_UpdateShipping">
        <dc:Bounds x="750" y="90" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SaveShipping_di" bpmnElement="Task_SaveShipping">
        <dc:Bounds x="750" y="310" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ViewRefund_di" bpmnElement="Task_ViewRefund">
        <dc:Bounds x="750" y="180" width="120" height="80" />
