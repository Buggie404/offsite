          <dc:Bounds x="908" y="165" width="64" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ApproveRefund_di" bpmnElement="Task_ApproveRefund">
        <dc:Bounds x="1020" y="150" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SaveApprove_di" bpmnElement="Task_SaveApprove">
        <dc:Bounds x="1020" y="310" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_EnterRejectReason_di" bpmnElement="Task_EnterRejectReason">
        <dc:Bounds x="1020" y="240" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RejectRefund_di" bpmnElement="Task_RejectRefund">
        <dc:Bounds x="1180" y="240" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SaveReject_di" bpmnElement="Task_SaveReject">
        <dc:Bounds x="1180" y="310" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AddNote_di" bpmnElement="Task_AddNote">
        <dc:Bounds x="750" y="40" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SaveNote_di" bpmnElement="Task_SaveNote">
        <dc:Bounds x="910" y="40" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RefreshNotifications_di" bpmnElement="Task_RefreshNotifications">
        <dc:Bounds x="1360" y="310" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="1542" y="162" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1534" y="205" width="52" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="268" y="180" />
        <di:waypoint x="310" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="430" y="180" />
        <di:waypoint x="470" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="530" y="220" />
        <di:waypoint x="530" y="310" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="590" y="350" />
        <di:waypoint x="670" y="350" />
        <di:waypoint x="670" y="205" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Ship_di" bpmnElement="Flow_Ship">
        <di:waypoint x="670" y="155" />
        <di:waypoint x="670" y="130" />
        <di:waypoint x="750" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Refund_di" bpmnElement="Flow_Refund">
        <di:waypoint x="695" y="180" />
        <di:waypoint x="750" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Note_di" bpmnElement="Flow_Note">
        <di:waypoint x="670" y="155" />
        <di:waypoint x="670" y="80" />
        <di:waypoint x="750" y="80" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="810" y="170" />
        <di:waypoint x="810" y="310" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="870" y="350" />
        <di:waypoint x="1360" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="870" y="220" />
        <di:waypoint x="915" y="220" />
      </bpmndi:BPMNEdge>
