+            <button type="button" class="sc-link" (click)="newChat()">Start a new chat</button>
+          </div>
+        } @else {
+          <footer class="sc-compose">
+            <textarea rows="1" [(ngModel)]="draft" (input)="onDraftInput()" (keydown)="onKey($event)" placeholder="Type a message…"></textarea>
+            <button type="button" class="sc-btn" (click)="send()" [disabled]="!draft.trim()">Send</button>
