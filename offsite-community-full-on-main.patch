+  display: flex; justify-content: space-between; align-items: center; padding: 12px 14px; background: $forest; color: #fff;
+  small { display: block; font-size: 11px; opacity: .85; }
+}
+.sc-close { background: transparent; border: 0; color: #fff; font-size: 22px; line-height: 1; cursor: pointer; }
+
+.sc-start { margin: auto; text-align: center; padding: 20px; p { margin: 0 0 12px; font-size: 14px; } }
+
+.sc-thread { flex: 1; overflow-y: auto; padding: 12px; display: flex; flex-direction: column; gap: 8px; }
+.sc-bubble {
+  max-width: 80%; padding: 8px 12px; border-radius: 12px; background: #f1ece3; align-self: flex-start; font-size: 14px;
+  p { margin: 0; white-space: pre-wrap; word-break: break-word; }
+  time { display: block; font-size: 10px; color: #8b8378; margin-top: 2px; }
+  &--bot { background: #e9eef6; }
+  &--me { align-self: flex-end; background: $forest; color: #fff; time { color: #cfdccf; } }
+  &--system { align-self: center; background: transparent; font-size: 12px; color: #8b8378; }
+}
+.sc-typing { font-size: 12px; color: #8b8378; }
+
+.sc-compose {
+  display: flex; gap: 8px; padding: 10px; border-top: 1px solid $border;
+  textarea { flex: 1; resize: none; border: 1px solid $border; border-radius: 10px; padding: 8px 10px; font: inherit; font-size: 14px; }
+}
+.sc-btn {
+  border: 0; background: $forest; color: #fff; border-radius: 999px; padding: 8px 16px; font-weight: 600; cursor: pointer;
+  &:disabled { opacity: .5; cursor: not-allowed; }
+}
+.sc-closed { padding: 12px; text-align: center; font-size: 13px; border-top: 1px solid $border; }
+.sc-link { background: none; border: 0; color: $forest; font-weight: 600; text-decoration: underline; cursor: pointer; }
