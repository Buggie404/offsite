+
+      @if (active.handoff_summary) {
+        <div class="chat-summary"><strong>Bot summary:</strong> {{ active.handoff_summary }}</div>
+      }
+
+      <div class="chat-thread" #thread>
+        @for (m of messages; track m._id || $index) {
+          <div class="bubble bubble--{{ m.sender_type }}">
+            @if (m.sender_type === 'bot') { <small>Chatbot</small> }
+            <p>{{ m.content }}</p>
+            <time>{{ m.created_at | date: 'HH:mm' }}</time>
+          </div>
+        }
+        @if (customerTyping) { <div class="typing">Customer is typing…</div> }
+      </div>
+
+      <footer class="chat-compose">
+        <textarea rows="2" [(ngModel)]="draft" (input)="onDraftInput()" (keydown)="onKey($event)"
+          [disabled]="!canReply"
+          [placeholder]="canReply ? 'Type a reply — Enter to send' : (active.status === 'closed' ? 'Conversation closed' : 'Take over this chat to reply')"></textarea>
+        <button type="button" class="btn btn-primary" (click)="send()" [disabled]="!canReply || !draft.trim()">Send</button>
+      </footer>
+    } @else {
+      <p class="chat-empty chat-empty--center">Select a conversation to start.</p>
+    }
+  </section>
+</div>
