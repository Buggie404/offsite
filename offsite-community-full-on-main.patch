+    @if (active) {
+      <header class="chat-pane__head">
+        <div>
+          <strong>{{ customerName(active) }}</strong>
+          @if (active.customer?.membership_tier) { <span class="tier">{{ active.customer?.membership_tier }}</span> }
+          <small>{{ active.conversation_id }}</small>
