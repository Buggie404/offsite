+  </div>
+</header>
+
+<div class="chat-layout">
+  <aside class="chat-list">
+    <div class="chat-filters">
+      @for (f of filters; track f.value) {
+        <button type="button" class="chat-filter" [class.active]="filter === f.value" (click)="filter = f.value">{{ f.label }}</button>
+      }
+    </div>
+
+    @for (c of visible; track c.conversation_id) {
+      <button type="button" class="chat-item" [class.active]="active?.conversation_id === c.conversation_id" (click)="select(c)">
+        <span class="chat-item__avatar">
+          @if (c.customer?.avatar_url) { <img [src]="c.customer?.avatar_url" [alt]="customerName(c)"> }
+          @else { {{ customerName(c).slice(0, 2).toUpperCase() }} }
+        </span>
+        <span class="chat-item__body">
+          <span class="chat-item__top">
+            <strong>{{ customerName(c) }}</strong>
+            <time>{{ c.last_message_at | date: 'HH:mm' }}</time>
+          </span>
+          <span class="chat-item__preview">{{ c.last_message_preview || 'No messages yet' }}</span>
+        </span>
+        <span class="chat-item__meta">
+          <span class="status status--{{ c.status }}">{{ c.status }}</span>
+          @if (c.unread_agent > 0) { <span class="unread">{{ c.unread_agent }}</span> }
+        </span>
+      </button>
+    } @empty {
+      <p class="chat-empty">No conversations.</p>
+    }
+  </aside>
+
